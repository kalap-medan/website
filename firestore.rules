// KALAP Firestore Rules — application v2.2.17 (approved stock batch deletion compatibility).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function myProfile() { return get(profilePath()).data; }
    function activeUser() { return hasProfile() && myProfile().active == true; }
    function roleIs(role) { return activeUser() && myProfile().role == role; }
    function isSuperadmin() { return roleIs('superadmin'); }
    function isSpv() { return roleIs('spv'); }
    function isCashier() { return roleIs('cashier'); }
    function isPartner() { return roleIs('partner'); }
    function isStaff() { return isSuperadmin() || isSpv(); }
    function isPOSUser() { return isStaff() || isCashier(); }

    function activeDailyResetAuthorization() {
      let authPath = /databases/$(database)/documents/dailyResetAuthorizations/active;
      return isStaff()
        && exists(authPath)
        && get(authPath).data.status == 'running'
        && get(authPath).data.requestedBy == request.auth.uid;
    }

    function resetAuthorizationContains(fieldName, documentId) {
      let authPath = /databases/$(database)/documents/dailyResetAuthorizations/active;
      return activeDailyResetAuthorization()
        && get(authPath).data.get(fieldName, []) is list
        && get(authPath).data.get(fieldName, []).hasAny([documentId]);
    }

    // Reset Seluruh Sistem: Superadmin aktif saja. Manifest diperbarui per batch
    // agar daftar dokumen yang diizinkan tetap kecil dan tidak melampaui batas ukuran.
    function activeFullSystemResetAuthorization() {
      let authPath = /databases/$(database)/documents/systemResetAuthorizations/active;
      return isSuperadmin()
        && exists(authPath)
        && get(authPath).data.status == 'running'
        && get(authPath).data.requestedBy == request.auth.uid;
    }

    function fullSystemResetContains(fieldName, documentId) {
      let authPath = /databases/$(database)/documents/systemResetAuthorizations/active;
      return activeFullSystemResetAuthorization()
        && get(authPath).data.get(fieldName, []) is list
        && get(authPath).data.get(fieldName, []).hasAny([documentId]);
    }

    function resetTimestampInTargetDay(timestampValue) {
      let authPath = /databases/$(database)/documents/dailyResetAuthorizations/active;
      return activeDailyResetAuthorization()
        && timestampValue is timestamp
        && timestampValue >= get(authPath).data.startAt
        && timestampValue < get(authPath).data.endAt;
    }

    function resetTransactionBelongsToTargetDay(transactionId) {
      let authPath = /databases/$(database)/documents/dailyResetAuthorizations/active;
      let transactionPath = /databases/$(database)/documents/transactions/$(transactionId);
      return activeDailyResetAuthorization()
        && exists(transactionPath)
        && (get(transactionPath).data.get('businessDate', '') == get(authPath).data.dateKey
          || resetTimestampInTargetDay(get(transactionPath).data.get('createdAt', null)));
    }

    function resetTransactionOrStockMovementBelongsToTargetDay(movementId) {
      let authPath = /databases/$(database)/documents/dailyResetAuthorizations/active;
      let movementPath = /databases/$(database)/documents/stockMovements/$(movementId);
      return activeDailyResetAuthorization()
        && exists(movementPath)
        && (resetTimestampInTargetDay(get(movementPath).data.get('createdAt', null))
          || (get(movementPath).data.get('transactionId', null) is string
            && resetTransactionBelongsToTargetDay(get(movementPath).data.transactionId)));
    }

    function businessDateIsOpen(dateKey) {
      let closingPath = /databases/$(database)/documents/dailyClosings/$(dateKey);
      return !exists(closingPath) || get(closingPath).data.status == 'open';
    }

    function validNewManagedUser(userId) {
      return request.resource.data.keys().hasAll([
        'uid', 'displayName', 'email', 'role', 'partnerId', 'partnerName',
        'active', 'createdAt', 'createdBy'
      ])
      && request.resource.data.uid == userId
      && request.resource.data.displayName is string
      && request.resource.data.email is string
      && request.resource.data.role in ['spv', 'cashier', 'partner']
      && request.resource.data.active == true
      && request.resource.data.createdBy == request.auth.uid
      && request.resource.data.createdAt == request.time
      && (request.resource.data.role == 'partner'
        ? request.resource.data.partnerId is string
          && get(/databases/$(database)/documents/partners/$(request.resource.data.partnerId)).data.active == true
        : request.resource.data.partnerId == null);
    }

    function linkedMovement(menuId) {
      let movementId = request.resource.data.get('lastMovementId', '');
      let movementPath = /databases/$(database)/documents/stockMovements/$(movementId);
      let movementDate = existsAfter(movementPath)
        ? getAfter(movementPath).data.get('businessDate', '') : '';
      let isPartnerMenu = resource.data.get('partnerId', null) is string
        && resource.data.partnerId.size() > 0;
      let previousStock = isPartnerMenu
        ? (resource.data.get('stockBusinessDate', '') == movementDate ? resource.data.stock : 0)
        : resource.data.stock;
      return movementId is string
        && movementId.size() > 0
        && existsAfter(movementPath)
        && getAfter(movementPath).data.menuId == menuId
        && getAfter(movementPath).data.actorUid == request.auth.uid
        && getAfter(movementPath).data.stockBefore == previousStock
        && getAfter(movementPath).data.stockAfter == request.resource.data.stock
        && (!isPartnerMenu || (movementDate is string
          && movementDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.stockBusinessDate == movementDate))
        && ((getAfter(movementPath).data.type == 'sale' && isPOSUser()
              && getAfter(movementPath).data.qty == previousStock - request.resource.data.stock)
          || (getAfter(movementPath).data.type == 'in' && isStaff()
              && getAfter(movementPath).data.qty == request.resource.data.stock - previousStock)
          || (getAfter(movementPath).data.type == 'sale_cancel' && isPOSUser()
              && getAfter(movementPath).data.qty == request.resource.data.stock - previousStock
              && getAfter(/databases/$(database)/documents/transactions/$(getAfter(movementPath).data.transactionId)).data.status == 'cancelled'
              && getAfter(/databases/$(database)/documents/transactions/$(getAfter(movementPath).data.transactionId)).data.cancelMovementIds.hasAny([movementId]))
          || (getAfter(movementPath).data.type in ['adjustment', 'reset'] && isStaff()
              && getAfter(movementPath).data.adjustmentDelta is int
              && getAfter(movementPath).data.adjustmentDelta != 0
              && getAfter(movementPath).data.stockAfter - getAfter(movementPath).data.stockBefore == getAfter(movementPath).data.adjustmentDelta
              && (getAfter(movementPath).data.adjustmentDelta > 0
                ? getAfter(movementPath).data.qty == getAfter(movementPath).data.adjustmentDelta && getAfter(movementPath).data.changeType == 'ditambah'
                : getAfter(movementPath).data.qty == 0 - getAfter(movementPath).data.adjustmentDelta && getAfter(movementPath).data.changeType == 'dikurang')));
    }

    // Validasi penghapusan batch stok yang benar-benar mengurangi saldo menu.
    // ID batch yang dihapus dipakai untuk memvalidasi perubahan saldo pada transaksi yang sama.
    function deletedStockBatchLinked(menuId) {
      let movementId = request.resource.data.get('lastMovementId', '');
      let movementPath = /databases/$(database)/documents/stockMovements/$(movementId);
      let movementDate = exists(movementPath)
        ? get(movementPath).data.get('businessDate', resource.data.get('stockBusinessDate', ''))
        : resource.data.get('stockBusinessDate', '');
      let isPartnerMenu = resource.data.get('partnerId', null) is string
        && resource.data.partnerId.size() > 0;
      let previousStock = isPartnerMenu
        ? (resource.data.get('stockBusinessDate', '') == movementDate ? resource.data.stock : 0)
        : resource.data.stock;
      return isStaff()
        && movementId is string
        && movementId.size() > 0
        && exists(movementPath)
        && !existsAfter(movementPath)
        && get(movementPath).data.menuId == menuId
        && get(movementPath).data.type == 'in'
        && get(movementPath).data.get('voided', false) == false
        && get(movementPath).data.get('editedQty', get(movementPath).data.qty) is int
        && get(movementPath).data.get('editedQty', get(movementPath).data.qty) > 0
        && request.resource.data.stock == previousStock - get(movementPath).data.get('editedQty', get(movementPath).data.qty)
        && (!isPartnerMenu || request.resource.data.stockBusinessDate == movementDate)
        && request.resource.data.updatedAt == request.time
        && (get(movementPath).data.get('requestId', null) == null
          || !existsAfter(/databases/$(database)/documents/stockRequests/$(get(movementPath).data.requestId)));
    }

    function validNewMenu(menuId) {
      return isStaff()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.partnerId is string
        && get(/databases/$(database)/documents/partners/$(request.resource.data.partnerId)).data.active == true
        && request.resource.data.price is int
        && request.resource.data.price > 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.active == true
        && request.resource.data.barcode is string
        && request.resource.data.barcode.size() > 3
        && (request.resource.data.stock == 0
          || (request.resource.data.lastMovementId is string
            && existsAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.lastMovementId))
            && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.lastMovementId)).data.menuId == menuId
            && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.lastMovementId)).data.type == 'in'
            && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.lastMovementId)).data.actorUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.lastMovementId)).data.stockBefore == 0
            && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.lastMovementId)).data.stockAfter == request.resource.data.stock
            && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.lastMovementId)).data.qty == request.resource.data.stock));
    }


    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isSuperadmin());
      allow list: if isSuperadmin();
      allow create: if isSuperadmin() && validNewManagedUser(userId);
      // Pemilik akun boleh memperbarui nama dan metadata waktu perubahan sandinya sendiri.
      // Password asli tidak pernah disimpan ke Firestore.
      allow update: if (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'updatedAt', 'passwordChangedAt', 'passwordChangedByName'
          ])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.updatedAt == request.time
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['passwordChangedAt'])
            || (request.resource.data.passwordChangedAt == request.time
              && request.resource.data.passwordChangedByName is string))
        ) || (
          isSuperadmin()
          && resource.data.role != 'superadmin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'active', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.active is bool
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
        );
      allow delete: if isSuperadmin() && resource.data.role != 'superadmin';
    }

    match /partners/{partnerId} {
      allow read: if isStaff();
      allow create: if isSuperadmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSuperadmin();
      allow delete: if isSuperadmin()
        && existsAfter(/databases/$(database)/documents/partnerArchives/$(partnerId))
        && getAfter(/databases/$(database)/documents/partnerArchives/$(partnerId)).data.originalPartnerId == partnerId
        && getAfter(/databases/$(database)/documents/partnerArchives/$(partnerId)).data.archivedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/partnerArchives/$(partnerId)).data.archivedAt == request.time;
    }

    match /partnerArchives/{partnerId} {
      allow get, list: if isSuperadmin();
      allow create: if isSuperadmin()
        && request.resource.data.originalPartnerId == partnerId
        && request.resource.data.active == false
        && request.resource.data.archivedBy == request.auth.uid
        && request.resource.data.archivedAt == request.time;
      allow update, delete: if false;
    }

    match /menus/{menuId} {
      allow read: if isStaff() || isCashier()
        || (isPartner() && resource.data.partnerId == myProfile().partnerId);
      allow create: if validNewMenu(menuId);
      allow update: if (isStaff()
          // Sinkronisasi saldo harian berjalan sebagai operasi khusus yang dibatasi
          // ke menu Mitra dan tiga field saldo/tanggal/waktu saja. Letakkan di awal
          // agar evaluasi tidak melewati cabang reset/movement yang lebih mahal.
          && resource.data.get('partnerId', null) is string
          && resource.data.partnerId.size() > 0
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0
          && request.resource.data.stockBusinessDate is string
          && (request.resource.data.stockBusinessDate == 'closed'
            || request.resource.data.stockBusinessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && request.resource.data.stockBusinessDate != resource.data.get('stockBusinessDate', '')
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'stockBusinessDate', 'updatedAt']))
        || (isStaff()
          && resetAuthorizationContains('menuIds', menuId)
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0
          && request.resource.data.updatedAt == request.time
          && request.resource.data.lastMovementId is string
          && resetAuthorizationContains('resetMovementIds', request.resource.data.lastMovementId)
          && ((resource.data.get('partnerId', null) is string
              && resource.data.partnerId.size() > 0
              && request.resource.data.stockBusinessDate == get(/databases/$(database)/documents/dailyResetAuthorizations/active).data.dateKey
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'stockBusinessDate', 'updatedAt', 'lastMovementId']))
            || ((resource.data.get('partnerId', null) == null
                || (resource.data.get('partnerId', null) is string && resource.data.partnerId.size() == 0))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt', 'lastMovementId']))))
        || (isSuperadmin()
          && fullSystemResetContains('menuIds', menuId)
          && request.resource.data.stock == 0
          && request.resource.data.lastMovementId == null
          && request.resource.data.updatedAt == request.time
          && ((resource.data.get('partnerId', null) is string && resource.data.partnerId.size() > 0)
            ? request.resource.data.stockBusinessDate == get(/databases/$(database)/documents/systemResetAuthorizations/active).data.resetDateKey
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'stockBusinessDate', 'updatedAt', 'lastMovementId'])
            : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt', 'lastMovementId'])))
        || (isSuperadmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'category', 'price', 'active', 'updatedAt', 'updatedBy']))
        || (isSuperadmin()
          // Menu lama belum tentu memiliki field `deleted`; gunakan default false.
          // Akses field langsung akan membuat evaluasi Rules gagal untuk dokumen lama.
          && resource.data.get('deleted', false) != true
          && request.resource.data.deleted == true
          && request.resource.data.active == false
          && request.resource.data.deletedAt == request.time
          && request.resource.data.deletedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','deletedAt','deletedBy','active','updatedAt','updatedBy']))
        || ((isPOSUser() || isStaff())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'stockBusinessDate', 'updatedAt', 'lastMovementId'])
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0
          && request.resource.data.updatedAt == request.time
          && (linkedMovement(menuId) || deletedStockBatchLinked(menuId)));
      allow delete: if isSuperadmin()
        && existsAfter(/databases/$(database)/documents/menuArchives/$(menuId))
        && getAfter(/databases/$(database)/documents/menuArchives/$(menuId)).data.originalMenuId == menuId
        && getAfter(/databases/$(database)/documents/menuArchives/$(menuId)).data.archivedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/menuArchives/$(menuId)).data.archivedAt == request.time;
    }

    match /menuArchives/{menuId} {
      allow get: if isPOSUser();
      allow list: if isStaff();
      allow create: if isSuperadmin()
        && request.resource.data.originalMenuId == menuId
        && request.resource.data.active == false
        && request.resource.data.deleted == true
        && request.resource.data.archivedBy == request.auth.uid
        && request.resource.data.archivedAt == request.time;
      allow update: if isPOSUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt', 'lastMovementId'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMovementId is string
        && existsAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.lastMovementId))
        && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.lastMovementId)).data.type == 'sale_cancel'
        && linkedMovement(menuId);
      allow delete: if false;
    }


    match /transactions/{transactionId} {
      allow read: if isStaff() || (isCashier() && resource.data.cashierUid == request.auth.uid);
      allow create: if isPOSUser()
        && request.resource.data.cashierUid == request.auth.uid
        && request.resource.data.status == 'completed'
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 10
        && request.resource.data.paymentMethod in ['cash', 'qris', 'transfer', 'kalap_operational']
        && request.resource.data.payerType in ['customer', 'kalap']
        && (request.resource.data.paymentMethod == 'kalap_operational'
          ? request.resource.data.payerType == 'kalap'
          : request.resource.data.payerType == 'customer')
        && request.resource.data.businessDate is string
        && (request.resource.data.paymentMethod == 'cash'
          ? request.resource.data.amountReceived is int && request.resource.data.amountReceived >= request.resource.data.total && request.resource.data.changeAmount == request.resource.data.amountReceived - request.resource.data.total
          : request.resource.data.amountReceived == null && request.resource.data.changeAmount == 0)
        && businessDateIsOpen(request.resource.data.businessDate)
        && request.resource.data.createdAt == request.time;
      allow update: if isPOSUser()
        && resource.data.status == 'completed'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancelBusinessDate is string
        && (resource.data.keys().hasAny(['businessDate'])
          ? request.resource.data.cancelBusinessDate == resource.data.businessDate
          : isStaff())
        && businessDateIsOpen(request.resource.data.cancelBusinessDate)
        && request.resource.data.cancelMovementIds is list
        && request.resource.data.cancelMovementIds.size() == resource.data.items.size()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','cancelledBy','cancelledByName','cancelBusinessDate','cancelReason','cancelMovementIds'])
        && (isStaff() || resource.data.cashierUid == request.auth.uid);
      allow delete: if fullSystemResetContains('transactionIds', transactionId)
        || (resetAuthorizationContains('transactionIds', transactionId)
          && (resource.data.get('businessDate', '') == get(/databases/$(database)/documents/dailyResetAuthorizations/active).data.dateKey
            || resetTimestampInTargetDay(resource.data.get('createdAt', null))));
    }

    match /stockMovements/{movementId} {
      allow read: if isStaff() || (isPartner() && resource.data.partnerId == myProfile().partnerId);
      allow create: if request.resource.data.actorUid == request.auth.uid
        && request.resource.data.menuId is string
        && request.resource.data.qty is int
        && request.resource.data.qty > 0
        && request.resource.data.stockBefore is int
        && request.resource.data.stockAfter is int
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.type == 'sale' && isPOSUser()
              && request.resource.data.stockBefore - request.resource.data.stockAfter == request.resource.data.qty
              && request.resource.data.transactionId is string
              && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.cashierUid == request.auth.uid
              && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.movementIds.hasAny([movementId])
              && existsAfter(/databases/$(database)/documents/menus/$(request.resource.data.menuId))
              && getAfter(/databases/$(database)/documents/menus/$(request.resource.data.menuId)).data.lastMovementId == movementId
              && getAfter(/databases/$(database)/documents/menus/$(request.resource.data.menuId)).data.stock == request.resource.data.stockAfter)
          || (request.resource.data.type == 'in' && isStaff()
              && request.resource.data.stockAfter - request.resource.data.stockBefore == request.resource.data.qty
              && existsAfter(/databases/$(database)/documents/menus/$(request.resource.data.menuId))
              && getAfter(/databases/$(database)/documents/menus/$(request.resource.data.menuId)).data.lastMovementId == movementId
              && getAfter(/databases/$(database)/documents/menus/$(request.resource.data.menuId)).data.stock == request.resource.data.stockAfter)
          || (request.resource.data.type == 'in' && isStaff()
              && request.resource.data.get('scheduledForFuture', false) == true
              && request.resource.data.source == 'manual'
              && request.resource.data.businessDate is string
              && request.resource.data.stockAfter - request.resource.data.stockBefore == request.resource.data.qty
              && exists(/databases/$(database)/documents/menus/$(request.resource.data.menuId))
              && get(/databases/$(database)/documents/menus/$(request.resource.data.menuId)).data.get('active', true) == true)
          || (request.resource.data.type == 'sale_cancel' && isPOSUser()
              && request.resource.data.stockAfter - request.resource.data.stockBefore == request.resource.data.qty
              && request.resource.data.transactionId is string
              && existsAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId))
              && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.status == 'cancelled'
              && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.cancelMovementIds.hasAny([movementId])
              && ((existsAfter(/databases/$(database)/documents/menus/$(request.resource.data.menuId))
                  && getAfter(/databases/$(database)/documents/menus/$(request.resource.data.menuId)).data.lastMovementId == movementId
                  && getAfter(/databases/$(database)/documents/menus/$(request.resource.data.menuId)).data.stock == request.resource.data.stockAfter)
                || (existsAfter(/databases/$(database)/documents/menuArchives/$(request.resource.data.menuId))
                  && getAfter(/databases/$(database)/documents/menuArchives/$(request.resource.data.menuId)).data.lastMovementId == movementId
                  && getAfter(/databases/$(database)/documents/menuArchives/$(request.resource.data.menuId)).data.stock == request.resource.data.stockAfter)))
          || (request.resource.data.type == 'adjustment' && isStaff()
              && request.resource.data.adjustmentDelta is int
              && request.resource.data.adjustmentDelta != 0
              && request.resource.data.stockAfter - request.resource.data.stockBefore == request.resource.data.adjustmentDelta
              && (request.resource.data.adjustmentDelta > 0
                ? request.resource.data.qty == request.resource.data.adjustmentDelta && request.resource.data.changeType == 'ditambah'
                : request.resource.data.qty == 0 - request.resource.data.adjustmentDelta && request.resource.data.changeType == 'dikurang')
              && existsAfter(/databases/$(database)/documents/menus/$(request.resource.data.menuId))
              && getAfter(/databases/$(database)/documents/menus/$(request.resource.data.menuId)).data.lastMovementId == movementId
              && getAfter(/databases/$(database)/documents/menus/$(request.resource.data.menuId)).data.stock == request.resource.data.stockAfter)
          || (request.resource.data.type == 'reset' && isStaff()
              && resetAuthorizationContains('menuIds', request.resource.data.menuId)
              && resetAuthorizationContains('resetMovementIds', movementId)
              && request.resource.data.businessDate == get(/databases/$(database)/documents/dailyResetAuthorizations/active).data.dateKey
              && request.resource.data.source == 'daily_reset'
              && request.resource.data.resetDateKey == request.resource.data.businessDate
              && request.resource.data.adjustmentDelta is int
              && request.resource.data.adjustmentDelta != 0
              && request.resource.data.stockAfter - request.resource.data.stockBefore == request.resource.data.adjustmentDelta
              && (request.resource.data.adjustmentDelta > 0
                ? request.resource.data.qty == request.resource.data.adjustmentDelta && request.resource.data.changeType == 'ditambah'
                : request.resource.data.qty == 0 - request.resource.data.adjustmentDelta && request.resource.data.changeType == 'dikurang')));
      allow update: if (isStaff()
          && resource.data.type == 'in'
          && resource.data.get('voided', false) == false
          && request.resource.data.editedQty is int
          && request.resource.data.editedQty > 0
          && request.resource.data.editedFromQty is int
          && request.resource.data.editedAt == request.time
          && request.resource.data.editedBy == request.auth.uid
          && request.resource.data.editedByName is string
          && request.resource.data.editNote is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'editedQty', 'editedFromQty', 'editedAt', 'editedBy', 'editedByName', 'editNote'
          ]))
        || (isStaff()
          && resource.data.type == 'in'
          && resource.data.get('voided', false) == false
          && request.resource.data.voided == true
          && request.resource.data.voidedAt == request.time
          && request.resource.data.voidedBy == request.auth.uid
          && request.resource.data.voidedByName is string
          && request.resource.data.voidReason is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'voided', 'voidedAt', 'voidedBy', 'voidedByName', 'voidReason'
          ])
          && (resource.data.get('requestId', null) == null
            || (existsAfter(/databases/$(database)/documents/stockRequests/$(resource.data.requestId))
              && getAfter(/databases/$(database)/documents/stockRequests/$(resource.data.requestId)).data.status == 'voided')))
        || (isStaff()
          && resource.data.type == 'in'
          && resource.data.get('voided', false) == false
          && resource.data.get('requestId', null) is string
          && exists(/databases/$(database)/documents/stockRequests/$(resource.data.requestId))
          && get(/databases/$(database)/documents/stockRequests/$(resource.data.requestId)).data.status == 'received'
          && get(/databases/$(database)/documents/stockRequests/$(resource.data.requestId)).data.get('requestType', 'stock') != 'adjustment'
          // Dokumen pengajuan lama dapat menyimpan penanda koreksi sebagai string kosong.
          // Kode aplikasi memperlakukan nilai kosong, null, dan field yang tidak ada sebagai belum dikoreksi.
          && (get(/databases/$(database)/documents/stockRequests/$(resource.data.requestId)).data.get('latestAdjustmentRequestId', null) == null
            || get(/databases/$(database)/documents/stockRequests/$(resource.data.requestId)).data.get('latestAdjustmentRequestId', '') == '')
          && get(/databases/$(database)/documents/stockRequests/$(resource.data.requestId)).data.movementId == movementId
          && get(/databases/$(database)/documents/stockRequests/$(resource.data.requestId)).data.menuId == resource.data.menuId
          && !exists(/databases/$(database)/documents/stockRequestLocks/$(resource.data.menuId))
          && !existsAfter(/databases/$(database)/documents/stockRequests/$(resource.data.requestId))
          && request.resource.data.hiddenFromDaily == true
          && request.resource.data.hiddenAt == request.time
          && request.resource.data.hiddenBy == request.auth.uid
          && request.resource.data.hiddenByName is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'hiddenFromDaily', 'hiddenAt', 'hiddenBy', 'hiddenByName'
          ]))
        || (isStaff()
          && resource.data.type == 'in'
          && resource.data.get('voided', false) == false
          && resource.data.get('requestId', null) == null
          && !exists(/databases/$(database)/documents/stockRequestLocks/$(resource.data.menuId))
          && request.resource.data.hiddenFromDaily == true
          && request.resource.data.hiddenAt == request.time
          && request.resource.data.hiddenBy == request.auth.uid
          && request.resource.data.hiddenByName is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'hiddenFromDaily', 'hiddenAt', 'hiddenBy', 'hiddenByName'
          ]));
      allow delete: if fullSystemResetContains('stockMovementIds', movementId)
        || (resetAuthorizationContains('stockMovementIds', movementId)
          && (resetTimestampInTargetDay(resource.data.get('createdAt', null))
            || (resource.data.get('transactionId', null) is string
              && resetAuthorizationContains('transactionIds', resource.data.transactionId))))
        || (isStaff()
          && resource.data.type == 'in'
          && resource.data.get('voided', false) == false
          && exists(/databases/$(database)/documents/menus/$(resource.data.menuId))
          && existsAfter(/databases/$(database)/documents/menus/$(resource.data.menuId))
          && getAfter(/databases/$(database)/documents/menus/$(resource.data.menuId)).data.lastMovementId == movementId
          && getAfter(/databases/$(database)/documents/menus/$(resource.data.menuId)).data.stock
            == get(/databases/$(database)/documents/menus/$(resource.data.menuId)).data.stock
              - resource.data.get('editedQty', resource.data.qty)
          && (resource.data.get('requestId', null) == null
            || !existsAfter(/databases/$(database)/documents/stockRequests/$(resource.data.requestId))));
    }


    match /cashflows/{cashflowId} {
      // Staf membaca semua catatan; kasir hanya boleh membaca catatan transaksi miliknya.
      allow read: if isStaff() || (isCashier() && resource.data.transactionId is string
        && get(/databases/$(database)/documents/transactions/$(resource.data.transactionId)).data.cashierUid == request.auth.uid);
      allow create: if (isStaff()
          && request.resource.data.source == 'operational'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.category is string
          && request.resource.data.category.size() > 0
          && request.resource.data.createdAt == request.time)
        || (isSuperadmin()
          && request.resource.data.source == 'manual'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.createdAt == request.time)
        || (isPOSUser()
          && request.resource.data.source == 'sale'
          && request.resource.data.type == 'income'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.transactionId is string
          && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.total == request.resource.data.amount
          && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.paymentMethod in ['cash', 'qris', 'transfer']
          && request.resource.data.createdAt == request.time)
        || (isPOSUser()
          && request.resource.data.source == 'operational_sale'
          && request.resource.data.type == 'expense'
          && request.resource.data.category == 'Beban operasional - penjualan'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.transactionId is string
          && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.total == request.resource.data.amount
          && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.paymentMethod == 'kalap_operational'
          && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.payerType == 'kalap'
          && request.resource.data.createdAt == request.time);
      allow update: if isPOSUser()
        && resource.data.transactionId is string
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','cancelledBy','cancelledByName'])
        && existsAfter(/databases/$(database)/documents/transactions/$(resource.data.transactionId))
        && getAfter(/databases/$(database)/documents/transactions/$(resource.data.transactionId)).data.status == 'cancelled'
        && (isStaff() || getAfter(/databases/$(database)/documents/transactions/$(resource.data.transactionId)).data.cashierUid == request.auth.uid);
      allow delete: if fullSystemResetContains('cashflowIds', cashflowId)
        || (resetAuthorizationContains('cashflowIds', cashflowId)
          && resource.data.source in ['sale', 'operational_sale']
          && resource.data.transactionId is string
          && resetAuthorizationContains('transactionIds', resource.data.transactionId));
    }

    match /partnerSales/{partnerSaleId} {
      allow read: if isStaff() || (isPartner() && resource.data.partnerId == myProfile().partnerId)
        || (isCashier() && resource.data.transactionId is string
          && get(/databases/$(database)/documents/transactions/$(resource.data.transactionId)).data.cashierUid == request.auth.uid);
      allow create: if isPOSUser()
        && request.resource.data.partnerId is string
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.transactionId is string
        && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.cashierUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isPOSUser()
        && resource.data.transactionId is string
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','cancelledBy','cancelledByName'])
        && existsAfter(/databases/$(database)/documents/transactions/$(resource.data.transactionId))
        && getAfter(/databases/$(database)/documents/transactions/$(resource.data.transactionId)).data.status == 'cancelled'
        && (isStaff() || getAfter(/databases/$(database)/documents/transactions/$(resource.data.transactionId)).data.cashierUid == request.auth.uid);
      allow delete: if fullSystemResetContains('partnerSaleIds', partnerSaleId)
        || (resetAuthorizationContains('partnerSaleIds', partnerSaleId)
          && resource.data.transactionId is string
          && resetAuthorizationContains('transactionIds', resource.data.transactionId));
    }

    match /stockRequests/{requestId} {
      allow read: if isStaff() || (isPartner() && resource.data.partnerId == myProfile().partnerId);

      // Pengajuan baru atau permintaan koreksi terhadap satu batch stok yang sudah diterima.
      allow create: if isPartner()
        && request.resource.data.partnerId == myProfile().partnerId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.menuId is string
        && request.resource.data.qty is int
        && request.resource.data.qty > 0
        && request.resource.data.qty <= 100000
        && request.resource.data.businessDate is string
        && businessDateIsOpen(request.resource.data.businessDate)
        && get(/databases/$(database)/documents/menus/$(request.resource.data.menuId)).data.partnerId == myProfile().partnerId
        && get(/databases/$(database)/documents/menus/$(request.resource.data.menuId)).data.active == true
        && get(/databases/$(database)/documents/partners/$(myProfile().partnerId)).data.active == true
        && request.resource.data.createdAt == request.time
        && (request.resource.data.get('requestType', 'stock') == 'stock'
          || (request.resource.data.requestType == 'adjustment'
            && request.resource.data.baseRequestId is string
            && exists(/databases/$(database)/documents/stockRequests/$(request.resource.data.baseRequestId))
            && get(/databases/$(database)/documents/stockRequests/$(request.resource.data.baseRequestId)).data.status == 'received'
            && get(/databases/$(database)/documents/stockRequests/$(request.resource.data.baseRequestId)).data.partnerId == myProfile().partnerId
            && get(/databases/$(database)/documents/stockRequests/$(request.resource.data.baseRequestId)).data.menuId == request.resource.data.menuId
            && get(/databases/$(database)/documents/stockRequests/$(request.resource.data.baseRequestId)).data.get('latestAdjustmentRequestId', null) == null
            && request.resource.data.previousQty == get(/databases/$(database)/documents/stockRequests/$(request.resource.data.baseRequestId)).data.get('receivedQty', get(/databases/$(database)/documents/stockRequests/$(request.resource.data.baseRequestId)).data.qty)
            && request.resource.data.deltaQty is int
            && request.resource.data.deltaQty == request.resource.data.qty - request.resource.data.previousQty
            && request.resource.data.deltaQty != 0
            && ((request.resource.data.deltaQty > 0 && request.resource.data.changeType == 'ditambah')
              || (request.resource.data.deltaQty < 0 && request.resource.data.changeType == 'dikurang'))))
        && existsAfter(/databases/$(database)/documents/stockRequestLocks/$(request.resource.data.menuId))
        && getAfter(/databases/$(database)/documents/stockRequestLocks/$(request.resource.data.menuId)).data.requestId == requestId
        && getAfter(/databases/$(database)/documents/stockRequestLocks/$(request.resource.data.menuId)).data.partnerId == myProfile().partnerId;

      allow update: if
        // Mitra boleh menambah jumlah pada pengajuan normal yang masih pending.
        (isPartner()
          && resource.data.partnerId == myProfile().partnerId
          && resource.data.status == 'pending'
          && resource.data.get('requestType', 'stock') == 'stock'
          && (!resource.data.keys().hasAny(['businessDate']) || businessDateIsOpen(resource.data.businessDate))
          && request.resource.data.status == 'pending'
          && request.resource.data.qty is int
          && request.resource.data.qty > resource.data.qty
          && request.resource.data.qty <= 100000
          && request.resource.data.previousQty == resource.data.qty
          && request.resource.data.changeType == 'ditambah'
          && request.resource.data.changeQty == request.resource.data.qty - resource.data.qty
          && request.resource.data.changedAt == request.time
          && request.resource.data.changedBy == request.auth.uid
          && request.resource.data.changedByName is string
          && exists(/databases/$(database)/documents/stockRequestLocks/$(resource.data.menuId))
          && get(/databases/$(database)/documents/stockRequestLocks/$(resource.data.menuId)).data.requestId == requestId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'qty', 'previousQty', 'changeType', 'changeQty', 'changedAt', 'changedBy', 'changedByName', 'note'
          ]))
        || (isStaff() && (
          // Revisi jumlah pengajuan baru; adjustment keeps its original received baseline.
          (resource.data.status in ['pending', 'revised']
            && request.resource.data.status == 'revised'
            && request.resource.data.qty is int
            && request.resource.data.qty > 0
            && request.resource.data.qty <= 100000
            && request.resource.data.previousQty == (resource.data.get('requestType', 'stock') == 'adjustment' ? resource.data.previousQty : resource.data.qty)
            && request.resource.data.revisedAt == request.time
            && request.resource.data.revisedBy == request.auth.uid
            && request.resource.data.revisedByName is string
            && request.resource.data.changeType in ['ditambah', 'dikurang', 'diedit']
            && request.resource.data.changeQty is int
            && (resource.data.get('requestType', 'stock') == 'adjustment'
              ? request.resource.data.deltaQty == request.resource.data.qty - resource.data.previousQty
              : true)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'qty', 'status', 'previousQty', 'revisionNote', 'revisedAt', 'revisedBy', 'revisedByName',
              'changeType', 'changeQty', 'changedAt', 'changedBy', 'deltaQty'
            ]))
          ||
          // Penerimaan stok harus membuat movement yang cocok dan melepaskan kunci menu.
          (resource.data.status in ['pending', 'revised']
            && request.resource.data.status == 'received'
            && request.resource.data.receivedBy == request.auth.uid
            && request.resource.data.receivedAt == request.time
            && request.resource.data.receivedQty == resource.data.qty
            && request.resource.data.receivedByName is string
            && request.resource.data.receivedDelta is int
            && request.resource.data.movementId is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'receivedAt', 'receivedBy', 'receivedByName', 'receivedQty', 'receivedDelta', 'movementId'
            ])
            && existsAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.movementId))
            && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.movementId)).data.requestId == requestId
            && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.movementId)).data.menuId == resource.data.menuId
            && (resource.data.get('requestType', 'stock') == 'adjustment'
              ? getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.movementId)).data.type == 'adjustment'
                && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.movementId)).data.adjustmentDelta == resource.data.deltaQty
                && request.resource.data.receivedDelta == resource.data.deltaQty
                && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.movementId)).data.qty == (resource.data.deltaQty > 0 ? resource.data.deltaQty : 0 - resource.data.deltaQty)
              : getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.movementId)).data.type == 'in'
                && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.movementId)).data.qty == resource.data.qty
                && request.resource.data.receivedDelta == resource.data.qty)
            && (!exists(/databases/$(database)/documents/stockRequestLocks/$(resource.data.menuId))
              || !existsAfter(/databases/$(database)/documents/stockRequestLocks/$(resource.data.menuId))))
          ||
          // Setelah koreksi disetujui, tandai batch sebelumnya agar tidak dikoreksi dua kali.
          (resource.data.status == 'received'
            && resource.data.get('latestAdjustmentRequestId', null) == null
            && request.resource.data.latestAdjustmentRequestId is string
            && request.resource.data.adjustmentAcceptedAt == request.time
            && request.resource.data.adjustmentAcceptedBy == request.auth.uid
            && existsAfter(/databases/$(database)/documents/stockRequests/$(request.resource.data.latestAdjustmentRequestId))
            && getAfter(/databases/$(database)/documents/stockRequests/$(request.resource.data.latestAdjustmentRequestId)).data.status == 'received'
            && getAfter(/databases/$(database)/documents/stockRequests/$(request.resource.data.latestAdjustmentRequestId)).data.baseRequestId == requestId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'latestAdjustmentRequestId', 'adjustmentAcceptedAt', 'adjustmentAcceptedBy'
            ]))
          || (resource.data.status in ['pending', 'revised']
            && request.resource.data.status == 'rejected'
            && request.resource.data.rejectReason is string
            && request.resource.data.rejectedAt == request.time
            && request.resource.data.rejectedBy == request.auth.uid
            && request.resource.data.rejectedByName is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'rejectReason', 'rejectedAt', 'rejectedBy', 'rejectedByName'
            ]))
          || (resource.data.status in ['pending', 'revised', 'received']
            && request.resource.data.status == 'voided'
            && request.resource.data.voidedAt == request.time
            && request.resource.data.voidedBy == request.auth.uid
            && request.resource.data.voidedByName is string
            && request.resource.data.voidReason is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'voidedAt', 'voidedBy', 'voidedByName', 'voidReason'
            ])
            && (resetTimestampInTargetDay(resource.data.get('createdAt', null))
              || (resource.data.get('movementId', null) is string
                && resetAuthorizationContains('stockMovementIds', resource.data.movementId)
                && resetTransactionOrStockMovementBelongsToTargetDay(resource.data.movementId))
              || (resource.data.status == 'received'
                && resource.data.get('movementId', null) is string
                && existsAfter(/databases/$(database)/documents/stockMovements/$(resource.data.movementId))
                && getAfter(/databases/$(database)/documents/stockMovements/$(resource.data.movementId)).data.requestId == requestId
                && getAfter(/databases/$(database)/documents/stockMovements/$(resource.data.movementId)).data.menuId == resource.data.menuId
                && getAfter(/databases/$(database)/documents/stockMovements/$(resource.data.movementId)).data.voided == true)))
          || (isStaff()
            && resetAuthorizationContains('stockRequestParentIds', requestId)
            && resource.data.status == 'received'
            && resource.data.get('latestAdjustmentRequestId', null) is string
            && resetAuthorizationContains('stockRequestIds', resource.data.latestAdjustmentRequestId)
            && request.resource.data.get('latestAdjustmentRequestId', null) == null
            && request.resource.data.get('adjustmentAcceptedAt', null) == null
            && request.resource.data.get('adjustmentAcceptedBy', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'latestAdjustmentRequestId', 'adjustmentAcceptedAt', 'adjustmentAcceptedBy'
            ]))
          || (resource.data.status == 'received'
            && request.resource.data.status == 'received'
            && request.resource.data.qty is int
            && request.resource.data.qty > 0
            && request.resource.data.qty <= 100000
            && request.resource.data.receivedQty == request.resource.data.qty
            && request.resource.data.previousQty is int
            && request.resource.data.editedAt == request.time
            && request.resource.data.editedBy == request.auth.uid
            && request.resource.data.editedByName is string
            && request.resource.data.editNote is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'qty', 'previousQty', 'receivedQty', 'editedAt', 'editedBy', 'editedByName', 'editNote'
            ]))
        ))
        || (((isStaff()) || (isPartner() && resource.data.partnerId == myProfile().partnerId))
          && resource.data.status in ['pending', 'revised']
          && request.resource.data.status == 'expired'
          && request.resource.data.expiredAt == request.time
          && request.resource.data.expiredBy == request.auth.uid
          && request.resource.data.expiredByName is string
          && request.resource.data.expiredForBusinessDate is string
          && request.resource.data.expiredForBusinessDate != resource.data.get('businessDate', '')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'expiredAt', 'expiredBy', 'expiredByName', 'expiredForBusinessDate'
          ]));
      allow delete: if fullSystemResetContains('stockRequestIds', requestId)
        || (resetAuthorizationContains('stockRequestIds', requestId)
          && resource.data.status in ['pending', 'received', 'voided']
          && (resetTimestampInTargetDay(resource.data.get('createdAt', null))
            || resetTimestampInTargetDay(resource.data.get('voidedAt', null))
            || (resource.data.get('movementId', null) is string
              && resetAuthorizationContains('stockMovementIds', resource.data.movementId))))
        || (isStaff() && resource.data.status == 'received'
          && resource.data.get('requestType', 'stock') != 'adjustment'
          && (resource.data.get('latestAdjustmentRequestId', null) == null
            || resource.data.get('latestAdjustmentRequestId', '') == '')
          && !exists(/databases/$(database)/documents/stockRequestLocks/$(resource.data.menuId))
          && resource.data.get('movementId', null) is string
          && exists(/databases/$(database)/documents/stockMovements/$(resource.data.movementId))
          && !existsAfter(/databases/$(database)/documents/stockMovements/$(resource.data.movementId))
          && get(/databases/$(database)/documents/stockMovements/$(resource.data.movementId)).data.requestId == requestId)
        || (isStaff() && resource.data.status == 'received'
          && resource.data.get('requestType', 'stock') != 'adjustment'
          && (resource.data.get('latestAdjustmentRequestId', null) == null
            || resource.data.get('latestAdjustmentRequestId', '') == '')
          && !exists(/databases/$(database)/documents/stockRequestLocks/$(resource.data.menuId))
          && resource.data.get('movementId', null) is string
          && exists(/databases/$(database)/documents/stockMovements/$(resource.data.movementId))
          && get(/databases/$(database)/documents/stockMovements/$(resource.data.movementId)).data.requestId == requestId
          && existsAfter(/databases/$(database)/documents/stockMovements/$(resource.data.movementId))
          && getAfter(/databases/$(database)/documents/stockMovements/$(resource.data.movementId)).data.requestId == requestId
          && getAfter(/databases/$(database)/documents/stockMovements/$(resource.data.movementId)).data.hiddenFromDaily == true
          && getAfter(/databases/$(database)/documents/stockMovements/$(resource.data.movementId)).data.hiddenAt == request.time
          && getAfter(/databases/$(database)/documents/stockMovements/$(resource.data.movementId)).data.hiddenBy == request.auth.uid);
    }

    match /stockRequestLocks/{menuId} {
      allow get: if isStaff()
        || (isPartner()
          && (!exists(/databases/$(database)/documents/stockRequestLocks/$(menuId))
            || resource.data.partnerId == myProfile().partnerId));
      allow list: if isStaff();
      allow create: if isPartner()
        && request.resource.data.menuId == menuId
        && request.resource.data.partnerId == myProfile().partnerId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.requestId is string
        && request.resource.data.businessDate is string
        && businessDateIsOpen(request.resource.data.businessDate)
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/stockRequests/$(request.resource.data.requestId))
        && getAfter(/databases/$(database)/documents/stockRequests/$(request.resource.data.requestId)).data.menuId == menuId
        && getAfter(/databases/$(database)/documents/stockRequests/$(request.resource.data.requestId)).data.partnerId == myProfile().partnerId
        && getAfter(/databases/$(database)/documents/stockRequests/$(request.resource.data.requestId)).data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/stockRequests/$(request.resource.data.requestId)).data.businessDate == request.resource.data.businessDate
        && getAfter(/databases/$(database)/documents/stockRequests/$(request.resource.data.requestId)).data.status == 'pending';
      allow update: if false;
      allow delete: if fullSystemResetContains('stockRequestLockIds', menuId)
        || resetAuthorizationContains('stockRequestLockIds', menuId)
        || (isStaff() && (
        // Bersihkan lock yatim atau lock yang sudah diselesaikan/dikadaluarsakan.
        !exists(/databases/$(database)/documents/stockRequests/$(resource.data.requestId))
        || (existsAfter(/databases/$(database)/documents/stockRequests/$(resource.data.requestId))
          && getAfter(/databases/$(database)/documents/stockRequests/$(resource.data.requestId)).data.status in ['received', 'rejected', 'voided', 'expired'])
      )) || (isPartner()
        && resource.data.partnerId == myProfile().partnerId
        && existsAfter(/databases/$(database)/documents/stockRequests/$(resource.data.requestId))
        && getAfter(/databases/$(database)/documents/stockRequests/$(resource.data.requestId)).data.status == 'expired'
        && getAfter(/databases/$(database)/documents/stockRequests/$(resource.data.requestId)).data.expiredBy == request.auth.uid);
    }

    match /dailyClosings/{dateKey} {
      // POS hanya perlu membaca dokumen pengunci tanggal ini; daftar riwayat khusus Superadmin/SPV.
      allow get: if isPOSUser();
      allow list: if isStaff();

      allow create: if isStaff()
        && request.resource.data.dateKey == dateKey
        && request.resource.data.status == 'closing'
        && request.resource.data.startedByUid == request.auth.uid
        && request.resource.data.startedAt == request.time
        && request.resource.data.closedAt == null
        && request.resource.data.createdAt == request.time;

      allow update: if isStaff() && (
        // Staff mulai proses closing; status lock mencegah transaksi POS baru.
        (resource.data.status == 'open'
          && request.resource.data.status == 'closing'
          && request.resource.data.dateKey == dateKey
          && request.resource.data.startedByUid == request.auth.uid
          && request.resource.data.startedAt == request.time
          && request.resource.data.closedAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'startedAt', 'startedByUid', 'startedByName', 'closedAt'
          ]))
        ||
        // Header ditutup dalam batch yang sama dengan ringkasan tiap mitra.
        (resource.data.status == 'closing'
          && request.resource.data.status == 'closed'
          && request.resource.data.closedByUid == request.auth.uid
          && request.resource.data.closedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'closedAt', 'closedByUid', 'closedByName', 'salesTotal',
            'transactionCount', 'soldQty', 'receivedQty', 'totalRemaining',
            'paymentBreakdown', 'operationalItems', 'partnerCount', 'updatedAt'
          ]))
        ||
        // Jika proses gagal, staff dapat membuka kembali tanggal tersebut.
        (resource.data.status == 'closing'
          && request.resource.data.status == 'open'
          && request.resource.data.failedAt == request.time
          && request.resource.data.failureMessage is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'failedAt', 'failureMessage'
          ]))
      );
      allow delete: if (activeDailyResetAuthorization()
          && get(/databases/$(database)/documents/dailyResetAuthorizations/active).data.dateKey == dateKey)
        || fullSystemResetContains('closingIds', dateKey);

      match /partnerSummaries/{partnerId} {
        allow get: if isStaff() || (isPartner() && partnerId == myProfile().partnerId);
        allow list: if isStaff();

        allow create: if isStaff()
          && request.resource.data.dateKey == dateKey
          && request.resource.data.partnerId == partnerId
          && request.resource.data.status == 'closed'
          && request.resource.data.disposition == 'pending'
          && request.resource.data.items is list
          && request.resource.data.totalRemaining is int
          && getAfter(/databases/$(database)/documents/dailyClosings/$(dateKey)).data.status == 'closed'
          && getAfter(/databases/$(database)/documents/dailyClosings/$(dateKey)).data.closedByUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.closedAt == request.time;

        allow update: if isPartner()
          && partnerId == myProfile().partnerId
          && resource.data.partnerId == myProfile().partnerId
          && resource.data.status == 'closed'
          && request.resource.data.status == 'closed'
          && request.resource.data.disposition in ['share', 'pickup']
          && request.resource.data.dispositionByUid == request.auth.uid
          && request.resource.data.dispositionByName is string
          && request.resource.data.dispositionAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'disposition', 'dispositionAt', 'dispositionByUid', 'dispositionByName', 'updatedAt'
          ])
          && get(/databases/$(database)/documents/dailyClosings/$(dateKey)).data.status == 'closed';
        allow delete: if (resetAuthorizationContains('closingSummaryIds', partnerId)
            && get(/databases/$(database)/documents/dailyResetAuthorizations/active).data.dateKey == dateKey)
          || fullSystemResetContains('closingSummaryIds', dateKey + '|' + partnerId);
      }
    }


    match /partnerPayouts/{payoutId} {
      allow read: if isStaff();
      allow create, update: if isSuperadmin()
        && request.resource.data.dateKey is string
        && request.resource.data.partnerId is string
        && request.resource.data.partnerName is string
        && request.resource.data.grossSales is int
        && request.resource.data.kalapShare is int
        && request.resource.data.transferAmount is int
        && request.resource.data.kalapShare >= 0
        && request.resource.data.transferAmount == request.resource.data.grossSales - request.resource.data.kalapShare
        && request.resource.data.status == 'paid'
        && request.resource.data.markedPaidBy == request.auth.uid
        && request.resource.data.markedPaidAt == request.time;
      allow delete: if fullSystemResetContains('payoutIds', payoutId)
        || (resetAuthorizationContains('payoutIds', payoutId)
          && resource.data.dateKey == get(/databases/$(database)/documents/dailyResetAuthorizations/active).data.dateKey);
    }

    match /dailyResetAuthorizations/{authId} {
      allow get, list: if isStaff();
      allow create: if isStaff()
        && authId == 'active'
        && request.resource.data.status == 'running'
        && request.resource.data.dateKey is string
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.endAt > request.resource.data.startAt
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedByName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.transactionIds is list
        && request.resource.data.menuIds is list
        && request.resource.data.resetMovementIds is list
        && request.resource.data.stockMovementIds is list
        && request.resource.data.cashflowIds is list
        && request.resource.data.partnerSaleIds is list
        && request.resource.data.stockRequestLockIds is list
        && request.resource.data.stockRequestIds is list
        && request.resource.data.stockRequestParentIds is list
        && request.resource.data.payoutIds is list
        && request.resource.data.closingSummaryIds is list;
      allow update: if isStaff() && authId == 'active' && (
        (resource.data.status in ['completed', 'failed']
          && request.resource.data.status == 'running'
          && request.resource.data.dateKey is string
          && request.resource.data.startAt is timestamp
          && request.resource.data.endAt is timestamp
          && request.resource.data.endAt > request.resource.data.startAt
          && request.resource.data.requestedBy == request.auth.uid
          && request.resource.data.requestedByName is string
          && request.resource.data.createdAt == request.time
          && request.resource.data.transactionIds is list
          && request.resource.data.menuIds is list
          && request.resource.data.resetMovementIds is list
          && request.resource.data.stockMovementIds is list
          && request.resource.data.cashflowIds is list
          && request.resource.data.partnerSaleIds is list
          && request.resource.data.stockRequestLockIds is list
          && request.resource.data.stockRequestIds is list
          && request.resource.data.stockRequestParentIds is list
          && request.resource.data.payoutIds is list
          && request.resource.data.closingSummaryIds is list
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'dateKey', 'startAt', 'endAt', 'status', 'requestedBy', 'requestedByName', 'createdAt',
            'transactionIds', 'menuIds', 'resetMovementIds', 'stockMovementIds', 'cashflowIds', 'partnerSaleIds',
            'stockRequestLockIds', 'stockRequestIds', 'stockRequestParentIds', 'payoutIds', 'closingSummaryIds',
            'completedAt', 'failedAt', 'failureMessage',
            'transactionCount', 'stockMovementCount', 'stockRequestCount', 'adjustedMenuCount'
          ]))
        || (resource.data.status == 'running'
          && resource.data.requestedBy == request.auth.uid
          && request.resource.data.status in ['completed', 'failed']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'completedAt', 'failedAt', 'failureMessage',
            'transactionCount', 'stockMovementCount', 'stockRequestCount', 'adjustedMenuCount'
          ])
          && (request.resource.data.status == 'completed'
            ? request.resource.data.completedAt == request.time
              && request.resource.data.transactionCount is int
              && request.resource.data.stockMovementCount is int
              && request.resource.data.stockRequestCount is int
              && request.resource.data.adjustedMenuCount is int
            : request.resource.data.failedAt == request.time
              && request.resource.data.failureMessage is string))
      );
      allow delete: if false;
    }

    match /systemResetAuthorizations/{authId} {
      allow get, list: if isSuperadmin();
      allow create: if isSuperadmin()
        && authId == 'active'
        && request.resource.data.status == 'running'
        && request.resource.data.resetDateKey is string
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedByName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.chunkIndex is int
        && request.resource.data.menuIds is list
        && request.resource.data.transactionIds is list
        && request.resource.data.cashflowIds is list
        && request.resource.data.partnerSaleIds is list
        && request.resource.data.stockMovementIds is list
        && request.resource.data.stockRequestIds is list
        && request.resource.data.stockRequestLockIds is list
        && request.resource.data.payoutIds is list
        && request.resource.data.closingIds is list
        && request.resource.data.closingSummaryIds is list;
      allow update: if isSuperadmin() && authId == 'active'
        && (
          // Pemilik proses yang sama boleh memperbarui manifest untuk batch berikutnya.
          (resource.data.status == 'running'
            && resource.data.requestedBy == request.auth.uid
            && request.resource.data.status == 'running'
            && request.resource.data.resetDateKey == resource.data.resetDateKey
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'menuIds', 'transactionIds', 'cashflowIds', 'partnerSaleIds', 'stockMovementIds',
              'stockRequestIds', 'stockRequestLockIds', 'payoutIds', 'closingIds',
              'closingSummaryIds', 'chunkIndex', 'updatedAt'
            ])
            && request.resource.data.menuIds is list
            && request.resource.data.transactionIds is list
            && request.resource.data.cashflowIds is list
            && request.resource.data.partnerSaleIds is list
            && request.resource.data.stockMovementIds is list
            && request.resource.data.stockRequestIds is list
            && request.resource.data.stockRequestLockIds is list
            && request.resource.data.payoutIds is list
            && request.resource.data.closingIds is list
            && request.resource.data.closingSummaryIds is list)
          ||
          // Selesaikan atau tandai gagal setelah seluruh batch selesai/terhenti.
          (resource.data.status == 'running'
            && resource.data.requestedBy == request.auth.uid
            && request.resource.data.status in ['completed', 'failed']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'completedAt', 'failedAt', 'failureMessage', 'committedChunks',
              'totalOperations', 'counts'
            ]))
          ||
          // Percobaan baru boleh dimulai setelah catatan sebelumnya selesai/gagal.
          (resource.data.status in ['completed', 'failed']
            && request.resource.data.status == 'running'
            && request.resource.data.resetDateKey is string
            && request.resource.data.requestedBy == request.auth.uid
            && request.resource.data.requestedByName is string
            && request.resource.data.createdAt == request.time
            && request.resource.data.chunkIndex == 0
            && request.resource.data.menuIds is list
            && request.resource.data.transactionIds is list
            && request.resource.data.cashflowIds is list
            && request.resource.data.partnerSaleIds is list
            && request.resource.data.stockMovementIds is list
            && request.resource.data.stockRequestIds is list
            && request.resource.data.stockRequestLockIds is list
            && request.resource.data.payoutIds is list
            && request.resource.data.closingIds is list
            && request.resource.data.closingSummaryIds is list
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'resetDateKey', 'status', 'requestedBy', 'requestedByName', 'createdAt', 'chunkIndex',
              'menuIds', 'transactionIds', 'cashflowIds', 'partnerSaleIds', 'stockMovementIds',
              'stockRequestIds', 'stockRequestLockIds', 'payoutIds', 'closingIds', 'closingSummaryIds'
            ]))
        );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
